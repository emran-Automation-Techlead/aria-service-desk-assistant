OPENAI_API_KEY=sk-proj-...

# Leave ARIA_MOCK_MODE=true to run ARIA fully offline against the local
# JSON knowledge base / ticket store in data/. Set to false and fill in
# the credentials below to connect a real Jira/Confluence/Okta tenant.
ARIA_MOCK_MODE=true
ARIA_MODEL=gpt-4o-mini
ARIA_PORT=7862

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

OKTA_DOMAIN=
OKTA_API_TOKEN=
